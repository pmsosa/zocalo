# Copy to .env, or let ./deploy.sh write it for you.
ZOCALO_PORT=8730              # port on the host
ZOCALO_DATA_DIR=./data        # database, encrypted keys, settings: back this folder up
ZOCALO_DATASETS_DIR=./datasets  # downloaded survey and census files (big, replaceable)
ZOCALO_AUTH=accounts          # "accounts" (login) or "none" (personal use on your own machine)
